# ============================================================
# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file to git!
# ============================================================

# --- Server ---
PORT=4000

# --- Database (PostgreSQL) ---
# Example: postgresql://myuser:mypassword@localhost:5432/movie_explorer
DATABASE_URL=postgres://postgres:oscar@localhost:5432/movie_explorer?schema=public

# --- JWT (used to create login tokens) ---
# Any long random string works. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=8cbc288c125998ec0e6db3f9ffb9816bd1a5745a560a941793afb241656c4572

# --- Admin login (used only for the admin dashboard) ---
ADMIN_EMAIL=desparteroscar@gmail.com
ADMIN_PASSWORD=12345678

# --- PayPal ---
# Get these from https://developer.paypal.com -> My Apps & Credentials
# Start with SANDBOX credentials while testing, switch to LIVE later.
PAYPAL_CLIENT_ID=ATAjNRP2pjcv4vTKTEeRS3TJMSG4z3NJaMb6EXr3BkPHgRR_B2si9lEeJW-Q0tJ6qu3rS0eiGT5gQXa1
PAYPAL_CLIENT_SECRET=EKc8PGvfp2Ke5QSsgmmXFHySovoU3ETQX4HXgRcINI0wv5km0gj8H2YyoBt_d5z1iqlnF8YPoC9qIosL
# "sandbox" while testing, "live" when you go live for real payments
PAYPAL_MODE=sandbox

# These two get filled in automatically after you run:
#   npm run create-paypal-plans
# (that script creates the $1/month and $10/year plans on PayPal for you)
PAYPAL_MONTHLY_PLAN_ID=P-4VA90311RE8052806NKI3KDY
PAYPAL_YEARLY_PLAN_ID=P-7JS08561DC4369633NKI3KEA

# Where PayPal should send the user back to after they approve payment.
# This can be a simple page on your own site, or deep link back into the app.
PAYPAL_RETURN_URL=http://localhost:4000/api/paypal/return
PAYPAL_CANCEL_URL=http://localhost:4000/api/paypal/cancel
