# ============================================================
# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file to git!
# ============================================================

# --- Server ---
PORT=4000

# --- Database (PostgreSQL) ---
# Example: postgresql://myuser:mypassword@localhost:5432/movie_explorer
DATABASE_URL=postgresql://your_user:your_password@localhost:5432/movie_explorer

# --- JWT (used to create login tokens) ---
# Any long random string works. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string

# --- Admin login (used only for the admin dashboard) ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose_a_strong_password

# --- M-Pesa (Safaricom Daraja) ---
# Get these from https://developer.safaricom.co.ke -> My Apps
# "sandbox" while testing, "live" when you go live for real payments
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret

# Sandbox test shortcode is 174379. For live, use your own Paybill / Till store number.
MPESA_SHORTCODE=174379
# The "Passkey" shown on the Daraja portal (sandbox: Simulate -> M-Pesa Express).
MPESA_PASSKEY=your_daraja_passkey

# "CustomerPayBillOnline" for a Paybill, "CustomerBuyGoodsOnline" for a Till number.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Only needed for a Till number: put the Till number here. Leave blank for a Paybill.
MPESA_PARTY_B=

# How much each plan costs, in Kenya Shillings (whole numbers).
# The Flutter app shows these prices too (lib/subscription/subscription_screen.dart),
# so if you change them here, change them there as well.
MPESA_MONTHLY_AMOUNT=130
MPESA_YEARLY_AMOUNT=1300

# --- M-Pesa callback (how Safaricom tells us a payment finished) ---
# 1. Make up a long random secret (this is what protects the callback endpoint):
#    node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MPESA_CALLBACK_TOKEN=replace_me_with_another_long_random_string
# 2. The PUBLIC https address of your server + /api/payments/callback + ?token=<the secret above>
#    (Safaricom can't reach localhost - use your Render URL, or ngrok while testing)
MPESA_CALLBACK_URL=https://your-server.onrender.com/api/payments/callback?token=replace_me_with_another_long_random_string
